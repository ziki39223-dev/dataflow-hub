# ===== 应用配置 =====
NODE_ENV=development
PORT=3000
API_PREFIX=api

# ===== 数据库 PostgreSQL =====
DATABASE_URL=postgresql://dataflow:dataflow@localhost:5432/dataflow_hub?schema=public

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== JWT =====
JWT_ACCESS_SECRET=your-access-secret-change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-change-me-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ===== RabbitMQ =====
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_TASK_EXCHANGE=dataflow.task.exchange
RABBITMQ_NOTIFICATION_QUEUE=dataflow.notification.queue

# ===== AI Provider =====
AI_PROVIDER=openai
AI_OPENAI_API_KEY=sk-xxx
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_MODEL=gpt-4o-mini
AI_LOCAL_BASE_URL=http://localhost:8080/v1
AI_LOCAL_MODEL=local-model

# ===== 日志 =====
LOG_LEVEL=debug
